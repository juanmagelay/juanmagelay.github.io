---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  /** Display width in CSS pixels. Use it for images exported at 2x. */
  maxWidth?: number;
  /** Use "eager" only for an image at the top of the page. */
  loading?: 'lazy' | 'eager';
}

const { src, alt, caption, credit, maxWidth, loading = 'lazy' } = Astro.props;

// Never upscale: small screenshots stay at their real size.
const maxDisplay = 832; // matches --layout-figure (52rem)
const displayWidth = Math.min(maxWidth ?? src.width, src.width, maxDisplay);
const widths = [...new Set([480, displayWidth, Math.min(src.width, displayWidth * 2)])]
  .filter((width) => width <= src.width)
  .sort((a, b) => a - b);
---

<figure class="figure" style={`--figure-width: ${displayWidth}px`}>
  <Image src={src} alt={alt} loading={loading} quality={80} widths={widths} sizes={`(min-width: 56rem) ${displayWidth}px, 100vw`} />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="figure-credit">Source: {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  /* Wide screenshots may extend past the text column, never past their real size. */
  .figure {
    width: min(100%, var(--figure-width, var(--layout-figure)));
    margin-block: var(--space-12);
  }

  :global(.prose) > .figure {
    max-width: none;
  }

  :global(.prose) > .figure:first-child {
    margin-top: 0;
  }

  :global(.prose) > .figure + :global(*) {
    margin-top: 0;
  }

  .figure :global(img) {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
  }

  figcaption {
    max-width: var(--layout-prose);
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--type-size-sm);
    line-height: 1.5;
  }

  .figure-credit {
    display: block;
  }
</style>
