---
import { site } from '../site.config.mjs';
import Button from './Button.astro';
import CopyEmail from './CopyEmail.astro';

const year = new Date().getFullYear();
// The base row's rule sits on an inner block so it spans the content, not the gutters.
---

<footer class="site-footer">
  <section class="container contact" id="contact" aria-labelledby="contact-title">
    <div>
      <h2 class="section-title" id="contact-title">Contact</h2>
      <p class="contact-lead">Email is the fastest way to reach me.</p>
    </div>

    <div class="contact-actions">
      <p class="contact-who">
        {site.name}, {site.role}. Based in {site.location}.{site.languages && ` Languages: ${site.languages}.`}
      </p>

      <CopyEmail email={site.email} />

      <ul class="contact-links">
        <li><Button href={site.cvPath} download={site.cvDownloadName} data-umami-event="cv-download" data-umami-event-location="footer" data-umami-event-language="en">Download CV</Button></li>
        <li><Button variant="quiet" href={site.linkedin} rel="me" data-umami-event="linkedin">LinkedIn</Button></li>
      </ul>

      <p class="contact-next">Case studies from my product work are on the way.</p>
    </div>
  </section>

  <div class="container">
    <div class="site-footer-base">
      <p>&copy; {year} {site.name}</p>
      <a href={site.github} rel="me">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }

  .contact {
    display: grid;
    gap: var(--space-8) var(--space-16);
    padding-block: var(--space-16);
  }

  .contact-lead {
    max-width: 16ch;
    margin-top: var(--space-4);
    font-family: var(--font-voice);
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-who {
    max-width: 36rem;
    color: var(--color-text-secondary);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-next {
    max-width: 36rem;
    color: var(--color-text-secondary);
    font-size: var(--type-size-sm);
  }

  @media (width >= 56rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .site-footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-data);
    font-size: var(--type-size-meta);
  }
</style>
