---
import { site } from '../site.config.mjs';
import CopyEmail from './CopyEmail.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <section class="container contact" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <p class="contact-who">
      {site.name}, {site.role}. Based in {site.location}.{site.languages && ` Languages: ${site.languages}.`}
    </p>
    <p class="contact-lead">Email is the fastest way to reach me.</p>

    <CopyEmail email={site.email} />

    <ul class="contact-links">
      <li><a class="button" href={site.cvPath} download={site.cvDownloadName} data-umami-event="cv-download" data-umami-event-location="footer" data-umami-event-language="en">Download CV</a></li>
      <li><a class="button button-quiet" href={site.cvSpanishPath} download={site.cvSpanishDownloadName} hreflang="es" data-umami-event="cv-download" data-umami-event-location="footer" data-umami-event-language="es">Download CV in Spanish</a></li>
      <li><a class="button button-quiet" href={site.linkedin} rel="me" data-umami-event="linkedin">LinkedIn</a></li>
    </ul>

    <p class="contact-next">
      Case studies from my product work are on the way. Until then, I'm happy to walk you through them on a call.
    </p>
  </section>

  <div class="container site-footer-base">
    <p>&copy; {year} {site.name}</p>
    <a href={site.github} rel="me">GitHub</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-24);
    border-top: 1px solid var(--color-rule);
  }

  .contact {
    padding-block: var(--space-16) var(--space-12);
  }

  .contact > * {
    max-width: var(--layout-prose);
  }

  .contact h2 {
    margin: 0;
    font-size: var(--type-size-xl);
    font-weight: var(--type-weight-bold);
  }

  .contact-who {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-muted);
  }

  .contact-lead {
    margin: var(--space-2) 0 var(--space-6);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-next {
    margin: var(--space-8) 0 0;
    color: var(--color-ink-muted);
    font-size: var(--type-size-sm);
  }

  .site-footer-base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-size: var(--type-size-sm);
  }

  .site-footer-base p {
    margin: 0;
  }

  .site-footer-base a {
    color: var(--color-ink-muted);
  }
</style>
