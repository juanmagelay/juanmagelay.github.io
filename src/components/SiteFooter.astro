---
import { site } from '../site.config.mjs';
import { cvFor, langFromPath, ui } from '../i18n.mjs';
import Button from './Button.astro';
import CopyEmail from './CopyEmail.astro';

const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const cv = cvFor(lang);
const languages = site.languages[lang];
const year = new Date().getFullYear();
// Two blocks, side by side from 64rem and stacked below: how to reach me, then who I am. Issue #12.
// Under 64rem the left column is too narrow for the email and the copy button on one line.
// The base row's rule sits on an inner block so it spans the content, not the gutters.
---

<footer class="site-footer">
  <section class="container contact" id="contact" aria-labelledby="contact-title">
    <div class="contact-reach">
      <h2 class="section-title" id="contact-title">{t.contactTitle}</h2>
      <p class="contact-lead">{t.contactLead}</p>
      <CopyEmail email={site.email} />
    </div>

    <div class="contact-about">
      <p class="contact-who">
        <span class="contact-name">{site.name}</span><br />
        <strong>{site.role[lang]}</strong>{` ${t.contactAt} `}<a href={site.company.url}>{site.company.name}</a>.<br />
        {`${t.contactBased} ${site.location[lang]}.`}
        {languages && <><br />{`${t.contactLanguages} ${languages}.`}</>}
      </p>

      <ul class="contact-links">
        <li><Button href={cv.href} download={cv.download} hreflang={cv.language} data-umami-event="cv-download" data-umami-event-location="footer" data-umami-event-language={cv.language}>{t.downloadCv}</Button></li>
        <li><Button variant="quiet" href={site.linkedin} rel="me" data-umami-event="linkedin">LinkedIn</Button></li>
      </ul>
    </div>
  </section>

  <div class="container">
    <div class="site-footer-base">
      <p>&copy; {year} {site.name}</p>
      <a href={site.github} rel="me">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }

  .contact {
    display: grid;
    gap: var(--space-8) var(--space-16);
    padding-block: var(--space-16);
  }

  .contact-reach {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Text style Lead: an intro line, not a headline. */
  .contact-lead {
    font-family: var(--font-text);
    font-size: var(--type-size-lead);
    line-height: var(--type-leading-body);
  }

  .contact-about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-who {
    max-width: 36rem;
    color: var(--color-text-secondary);
  }

  .contact-name {
    color: var(--color-accent);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .site-footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-data);
    font-size: var(--type-size-meta);
  }
</style>
