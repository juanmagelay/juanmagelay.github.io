---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import SpecList from './SpecList.astro';

// Facts about the thing a page analyzes, such as a game: an optional cover and a stacked spec list.
interface Props {
  /** Accessible name of the aside, e.g. "About the game". */
  label: string;
  items: ComponentProps<typeof SpecList>['items'];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { label, items, image, imageAlt = '' } = Astro.props;

// The frame is 7rem (112px) below 56rem and 14rem (224px) from there, at 1x to 3x. Never upscale.
const widths = image ? [...new Set([112, 224, 336, 448].map((width) => Math.min(width, image.width)))] : [];
---

<aside class="fact-sheet" aria-label={label}>
  {image && <Image class="fact-sheet-image" src={image} alt={imageAlt} widths={widths} sizes="(min-width: 56rem) 14rem, 7rem" loading="eager" />}
  <SpecList items={items} variant="stacked" />
</aside>

<style>
  .fact-sheet {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
  }

  /* 2:3 frame from the template. A cover with another ratio is cropped to fill it, never stretched. */
  .fact-sheet :global(.fact-sheet-image) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
  }

  @media (width >= 56rem) {
    .fact-sheet {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
