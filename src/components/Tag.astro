---
// Tags from the design system (.tag-list and .tag in design/templates/styles.css): short labels in a row that
// wraps, in the data font, with a 1px border and pill corners. Made for the tags of a case study. Issue #21.
interface Props {
  items: string[];
  /** Names the list for screen readers, such as "Topics". */
  label: string;
  class?: string;
}

const { items, label, class: className } = Astro.props;
---

<ul class:list={['tag-list', className]} aria-label={label}>
  {items.map((item) => <li class="tag">{item}</li>)}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-family: var(--font-data);
    font-size: var(--type-size-tag);
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
