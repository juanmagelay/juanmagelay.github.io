---
import { site } from '../site.config.mjs';
import Button from './Button.astro';

// Menu items. Add Work and About here once those pages exist.
// `within` lists the paths of the pages that belong to the item's section, such as posts in Writing.
const nav = [
  { label: 'Writing', href: '/writing/', event: 'nav-writing', within: ['/writing/'] },
  { label: 'Contact', href: '#contact', event: 'nav-contact' },
];

// "page" on the item's own page, "true" on a page inside its section. Both are underlined.
const path = Astro.url.pathname;
const current = (item: (typeof nav)[number]) => {
  if (item.href === path) return 'page';
  if (item.within?.some((prefix) => path.startsWith(prefix))) return 'true';
  return undefined;
};
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="site-name" href="/">{site.name}</a>
    <nav class="site-nav-wrap" aria-label="Main">
      <ul class="site-nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-umami-event={item.event} aria-current={current(item)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button class="site-cv" href={site.cvPath} download={site.cvDownloadName} data-umami-event="cv-download" data-umami-event-location="header" data-umami-event-language="en">Download CV</Button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 4.5rem;
    padding-block: var(--space-3);
  }

  .site-name {
    font-family: var(--font-voice);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: var(--tracking-name);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav-wrap {
    margin-left: auto;
  }

  .site-nav {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    font-size: var(--type-size-sm);
    text-decoration: none;
  }

  .site-nav a[aria-current] {
    text-decoration: underline;
  }

  /* Below 640px: name and CV on top, menu underneath. */
  @media (width < 40rem) {
    .site-header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name cv' 'nav nav';
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3) var(--space-2);
    }

    .site-name {
      grid-area: name;
    }

    .site-header-inner > :global(.site-cv) {
      grid-area: cv;
    }

    .site-nav-wrap {
      grid-area: nav;
      margin-left: 0;
    }

    .site-nav {
      gap: var(--space-5);
    }

    .site-nav a {
      display: inline-block;
      padding-block: var(--space-2);
    }
  }
</style>
