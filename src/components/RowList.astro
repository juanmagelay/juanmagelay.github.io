---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Rows from the design system: a title, optionally linked, with a line of text and a label on the right.
// With a link, the whole row is clickable. With an image, a 3:2 thumbnail goes on the left.
interface Item {
  title: string;
  href?: string;
  text?: string;
  meta?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  items: Item[];
  /** Level of each row title, so it fits under the page's headings. */
  headingLevel?: 2 | 3;
  class?: string;
}

const { items, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}`;

// The thumbnail is 12rem (192px) from 40rem and the full row width below, at 1x to 3x. Never upscale.
const widths = (image: ImageMetadata) => [...new Set([192, 384, 576, 768, 1152].map((width) => Math.min(width, image.width)))];
---

<ul class:list={['row-list', className]}>
  {
    items.map((item, index) => (
      <li class:list={['row', item.image && 'row-with-image']}>
        {item.image && (
          <Image
            class="row-image"
            src={item.image}
            alt={item.imageAlt ?? ''}
            widths={widths(item.image)}
            sizes="(min-width: 40rem) 12rem, 100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        )}
        <Heading class="row-title">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</Heading>
        {item.text && <p class="row-text">{item.text}</p>}
        {item.meta && <p class="row-meta">{item.meta}</p>}
      </li>
    ))
  }
</ul>

<style>
  .row-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row-title {
    font-family: var(--font-voice);
    font-size: var(--type-size-row);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: var(--tracking-card);
  }

  .row-title a {
    text-decoration: none;
  }

  .row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:hover .row-title a {
    color: var(--color-accent);
  }

  .row-text {
    grid-column: 1;
    max-width: var(--layout-prose);
    color: var(--color-text-secondary);
    font-size: var(--type-size-sm);
  }

  .row-meta {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-text-secondary);
    font-family: var(--font-data);
    font-size: var(--type-size-meta);
    text-align: right;
    white-space: nowrap;
  }

  /* With a thumbnail: the image on the left, across the title and the text. */
  .row-with-image {
    grid-template-columns: var(--layout-rail) minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'image title meta'
      'image text .';
    column-gap: var(--space-6);
  }

  .row-with-image :global(.row-image) {
    grid-area: image;
    align-self: start;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
  }

  .row-with-image .row-title {
    grid-area: title;
  }

  .row-with-image .row-text {
    grid-area: text;
  }

  .row-with-image .row-meta {
    grid-area: meta;
  }

  /* Below 640px the label goes under the title, and the thumbnail on top at full width. */
  @media (width < 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row-meta {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
    }

    .row-with-image {
      grid-template-rows: none;
      grid-template-areas: 'image' 'title' 'text' 'meta';
    }

    .row-with-image :global(.row-image) {
      margin-bottom: var(--space-2);
    }
  }
</style>
