---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  game: { name: string; developer: string; released: number; genre: string; platform?: string };
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { game, cover, coverAlt = '' } = Astro.props;
---

<aside class="game-sheet" aria-label="About the game">
  {cover && <Image class="game-cover" src={cover} alt={coverAlt} width={Math.min(cover.width, 240)} />}
  <dl>
    <div>
      <dt>Game</dt>
      <dd>{game.name}</dd>
    </div>
    <div>
      <dt>Developer</dt>
      <dd>{game.developer}</dd>
    </div>
    <div>
      <dt>Released</dt>
      <dd>{game.released}</dd>
    </div>
    <div>
      <dt>Genre</dt>
      <dd>{game.genre}</dd>
    </div>
    {
      game.platform && (
        <div>
          <dt>Platform</dt>
          <dd>{game.platform}</dd>
        </div>
      )
    }
  </dl>
</aside>

<style>
  .game-sheet {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .game-sheet :global(.game-cover) {
    width: 100%;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 12px 24px -12px rgb(0 0 0 / 0.45);
  }

  dl {
    margin: 0;
    font-size: var(--type-size-sm);
    line-height: 1.45;
  }

  dl > div + div {
    margin-block-start: var(--space-3);
  }

  dt {
    color: var(--color-ink-muted);
  }

  dd {
    margin: 0;
    font-weight: var(--type-weight-medium);
  }

  @media (min-width: 56rem) {
    .game-sheet {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
