---
import { LANGS, languages, langFromPath, localizePath, ui } from '../i18n.mjs';

// The same page in each language, at the top right of the header. The code is visible; the language
// name, written in that language, completes it for screen readers. The current language is underlined.
const path = Astro.url.pathname;
const current = langFromPath(path);
const items = LANGS.map((lang) => ({
  lang,
  code: lang.toUpperCase(),
  name: languages[lang].name,
  htmlLang: languages[lang].htmlLang,
  href: localizePath(path, lang),
}));
---

<nav class="site-lang-wrap" aria-label={ui[current].languageLabel}>
  <ul class="site-lang">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            hreflang={item.lang}
            lang={item.htmlLang}
            aria-current={item.lang === current ? 'true' : undefined}
            data-umami-event="language-switch"
            data-umami-event-language={item.lang}
          >
            {item.code}{' '}<span class="visually-hidden">{item.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Each code is a 44px target. The list moves right by the code's side space, so the last code
     lines up with the container's edge. */
  .site-lang {
    display: flex;
    margin: 0;
    margin-inline-end: calc((2.75rem - 2ch) / -2);
    padding: 0;
    font-family: var(--font-data);
    font-size: var(--type-size-meta);
    list-style: none;
  }

  .site-lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .site-lang a:hover {
    color: var(--color-accent);
  }

  .site-lang a[aria-current] {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
