---
import Button from './Button.astro';

interface Props {
  email: string;
}
const { email } = Astro.props;
---

<div class="copy-email">
  <a class="copy-email-address" href={`mailto:${email}`} data-umami-event="email-click">{email}</a>
  <Button variant="quiet" data-copy-email={email}>Copy email</Button>
  <span class="copy-email-status" role="status" aria-live="polite"></span>
</div>

<script>
  type Umami = { track: (event: string) => void };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('.copy-email-status');

    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (status) status.textContent = 'Copied';
        (window as Window & { umami?: Umami }).umami?.track('email-copy');
      } catch {
        if (status) status.textContent = "Couldn't copy. Select the address instead.";
      }
      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 3000);
    });
  }
</script>

<style>
  .copy-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .copy-email-address {
    font-family: var(--font-data);
    font-size: var(--type-size-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .copy-email-address:hover {
    text-decoration: underline;
  }

  .copy-email-status {
    color: var(--color-text-secondary);
    font-family: var(--font-data);
    font-size: var(--type-size-meta);
  }
</style>
