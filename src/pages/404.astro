---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="container not-found">
    <h1>This page doesn't exist</h1>
    <p>The address may be mistyped, or the page moved.</p>
    <p><a href="/games/warcraft-iii-ux-analysis/">Read the Warcraft III analysis</a> or use the contact details below.</p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-24) 0;
  }

  .not-found > * {
    max-width: var(--layout-prose);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--type-size-xl);
  }

  p {
    margin: var(--space-2) 0 0;
  }
</style>
