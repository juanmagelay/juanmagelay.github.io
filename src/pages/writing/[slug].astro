---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import FactSheet from '../../components/FactSheet.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const typeLabels = {
  playable: 'Playable game',
  analysis: 'Game UX analysis',
  academic: 'Academic project',
};

const words = (entry.body ?? '')
  .replace(/^import .*$/gm, ' ')
  .replace(/\{\/\*[\s\S]*?\*\/\}/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 230));

const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });

const og = data.ogImage ? await getImage({ src: data.ogImage, width: 1200, format: 'jpeg' }) : undefined;

const meta = [
  { label: 'Type', value: typeLabels[data.type] },
  { label: 'Context', value: data.context },
  { label: 'Published', value: dateFormat.format(data.pubDate), datetime: data.pubDate.toISOString() },
  { label: 'Reading time', value: `${readingMinutes} min` },
];

const gameFacts = data.game && [
  { label: 'Game', value: data.game.name },
  { label: 'Developer', value: data.game.developer },
  { label: 'Released', value: data.game.released },
  { label: 'Genre', value: data.game.genre },
  { label: 'Platform', value: data.game.platform },
];
---

<BaseLayout title={data.title} description={data.description} ogImage={og?.src} ogType="article" publishedTime={data.pubDate}>
  <article>
    <PageHead title={data.title} dek={data.description} meta={meta}>
      {gameFacts && <FactSheet slot="aside" label="About the game" items={gameFacts} image={data.cover} imageAlt={data.coverAlt} />}
    </PageHead>

    <div class="container container-reading article-body">
      <div class="prose">
        <Content />
      </div>
      {data.credits && <p class="article-credits">{data.credits}</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .article-body {
    padding-bottom: var(--space-16);
  }

  .article-credits {
    max-width: var(--layout-prose);
    margin: var(--space-16) auto 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--type-size-sm);
  }
</style>
