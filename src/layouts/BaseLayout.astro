---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../site.config.mjs';
import { LANGS, DEFAULT_LANG, languages, langFromPath, localizePath, ui } from '../i18n.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** For pages search engines should not list, such as the 404 pages. */
  noindex?: boolean;
}

const { title, description, ogImage, ogType = 'website', publishedTime, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const lang = langFromPath(path);
const canonical = new URL(path, Astro.site).href;
const fullTitle = `${title} | ${site.name}`;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
// The same page in each language, so search engines show each reader their own.
const alternates = LANGS.map((other) => ({ hreflang: other, href: new URL(localizePath(path, other), Astro.site).href }));
const defaultHref = new URL(localizePath(path, DEFAULT_LANG), Astro.site).href;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    {/* Same as --color-paper in each theme (src/styles/tokens.css). */}
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161B" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {LANGS.filter((other) => other !== lang).map((other) => <meta property="og:locale:alternate" content={languages[other].ogLocale} />)}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    {/* Preload the fonts every page shows above the fold: headings and text, not the italic or mono. */}
    <Font cssVariable="--font-voice" preload />
    <Font cssVariable="--font-text" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-data" />

    {
      site.umamiWebsiteId && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={site.umamiWebsiteId}
          data-domains={Astro.site?.hostname}
        ></script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
